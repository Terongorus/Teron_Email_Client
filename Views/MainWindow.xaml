<Window x:Class="TeronEmailClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teron Email Client"
        Height="800" Width="1300" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="1"
        FontFamily="{StaticResource UiFontFamily}"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="/Resources/email.ico"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Title bar ===================== -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="/Resources/email.ico" Width="18" Height="18" Margin="14,0,8,0" VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TitleBarForegroundBrush}"
                       Text="{Binding SelectedAccount.DisplayName, FallbackValue=Teron’s Email Client, TargetNullValue=Teron’s Email Client}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Minimize" Click="MinimizeButton_Click">
                    <Path Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconMinimize}" />
                </Button>
                <Button x:Name="MaximizeRestoreButton" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Maximize" Click="MaximizeRestoreButton_Click">
                    <Path x:Name="MaximizeRestorePath" Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconMaximize}" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseTitleBarButtonStyle}" ToolTip="Close" Click="CloseButton_Click">
                    <Path Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconClose}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Nav rail -->
            <Border Grid.Column="0" Background="{DynamicResource NavRailBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="AccountList" Grid.Row="0" Margin="0,12,0,0"
                             Style="{StaticResource NavAccountListStyle}"
                             ItemsSource="{Binding Accounts}"
                             SelectedItem="{Binding SelectedAccount}" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button Style="{StaticResource NavRailActionButtonStyle}" ToolTip="Add account" Click="AddAccountButton_Click">
                            <Path Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconAdd}" />
                        </Button>
                        <Button Style="{StaticResource NavRailActionButtonStyle}" ToolTip="Settings" Click="SettingsButton_Click">
                            <Path Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconSettings}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Browser toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="BackButton" Style="{StaticResource ToolbarIconButtonStyle}"
                                    ToolTip="Back" Click="BackButton_Click"
                                    IsEnabled="{Binding SelectedAccount.CanGoBack}">
                                <Path Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconBack}" />
                            </Button>
                            <Button x:Name="ForwardButton" Style="{StaticResource ToolbarIconButtonStyle}"
                                    ToolTip="Forward" Click="ForwardButton_Click"
                                    IsEnabled="{Binding SelectedAccount.CanGoForward}">
                                <Path Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconForward}" />
                            </Button>
                            <Button x:Name="ReloadButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Reload" Click="ReloadButton_Click">
                                <Path Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconReload}" />
                            </Button>
                            <Button x:Name="HomeButton" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Home" Click="HomeButton_Click">
                                <Path Style="{StaticResource ButtonIconPathStyle}" Data="{StaticResource IconHome}" />
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,16,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SelectedAccount.DisplayName}" />
                    </Grid>
                </Border>

                <!-- WebView host: account WebView2 controls are added/removed here in code -->
                <Grid x:Name="WebViewHost" Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}" />

                <!-- Welcome / empty state -->
                <Border x:Name="WelcomePanel" Grid.Row="0" Grid.RowSpan="2"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                        <TextBlock Text="Welcome to Teron's Email Client" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,28" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Add a webmail account to get started. Switch instantly between accounts, just like Outlook 365." />

                        <WrapPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource ServiceTileButtonStyle}" Tag="Gmail" Click="WelcomeTile_Click">
                                <StackPanel>
                                    <Image Source="/Resources/gmail.png" Width="40" Height="40" HorizontalAlignment="Center" />
                                    <TextBlock Text="Gmail" Margin="0,10,0,0" FontSize="13" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ServiceTileButtonStyle}" Tag="Outlook" Click="WelcomeTile_Click">
                                <StackPanel>
                                    <Image Source="/Resources/outlook.png" Width="40" Height="40" HorizontalAlignment="Center" />
                                    <TextBlock Text="Outlook" Margin="0,10,0,0" FontSize="13" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Button Style="{StaticResource SecondaryButtonStyle}" Tag="Custom" Click="WelcomeTile_Click"
                                Content="+ Add a custom mailbox" Margin="0,20,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
