<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3B3A39" />

    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#F3F2F1" />

    <SolidColorBrush x:Key="NavRailBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#2D2D2D" />
