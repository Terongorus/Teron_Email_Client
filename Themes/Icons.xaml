<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 20x20 viewbox line-art icons. Vector geometry is used instead of an icon font
         because Segoe Fluent Icons / Segoe MDL2 Assets PUA glyphs fail to render
         (show as missing-glyph boxes) under the .NET (Core) WPF text engine here,
         even though the fonts and glyphs are installed and resolve fine under
         .NET Framework WPF. Vector paths sidestep the issue entirely. -->

    <PathGeometry x:Key="IconClose" Figures="M6,6 L14,14 M14,6 L6,14" />
    <PathGeometry x:Key="IconMinimize" Figures="M6,14 L14,14" />
    <PathGeometry x:Key="IconMaximize" Figures="M5,5 L15,5 L15,15 L5,15 Z" />
    <PathGeometry x:Key="IconRestore" Figures="M8,5 L15,5 L15,12 L12,12 M5,8 L12,8 L12,15 L5,15 Z" />
    <PathGeometry x:Key="IconBack" Figures="M12,4 L6,10 L12,16" />
    <PathGeometry x:Key="IconForward" Figures="M8,4 L14,10 L8,16" />
    <PathGeometry x:Key="IconHome" Figures="M3,9 L10,3 L17,9 M5,8 L5,17 L15,17 L15,8" />
    <PathGeometry x:Key="IconAdd" Figures="M10,4 L10,16 M4,10 L16,10" />
    <PathGeometry x:Key="IconDelete" Figures="M4,6 L16,6 M7,6 L7,4 L13,4 L13,6 M6,6 L6,17 L14,17 L14,6" />

    <PathGeometry x:Key="IconReload">
        <PathFigure StartPoint="15,6" IsClosed="False">
            <ArcSegment Point="5,11" Size="6,6" SweepDirection="Clockwise" IsLargeArc="True" />
        </PathFigure>
        <PathFigure StartPoint="15,6" IsClosed="False">
            <LineSegment Point="15,2" />
        </PathFigure>
        <PathFigure StartPoint="15,6" IsClosed="False">
            <LineSegment Point="11,5" />
        </PathFigure>
    </PathGeometry>

    <GeometryGroup x:Key="IconSettings">
        <LineGeometry StartPoint="4,6" EndPoint="16,6" />
        <LineGeometry StartPoint="4,10" EndPoint="16,10" />
        <LineGeometry StartPoint="4,14" EndPoint="16,14" />
        <EllipseGeometry Center="8,6" RadiusX="1.8" RadiusY="1.8" />
        <EllipseGeometry Center="13,10" RadiusX="1.8" RadiusY="1.8" />
        <EllipseGeometry Center="9,14" RadiusX="1.8" RadiusY="1.8" />
    </GeometryGroup>

    <Style x:Key="ButtonIconPathStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>

</ResourceDictionary>
