<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D0CFCD" />

    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#1F1F1F" />

    <SolidColorBrush x:Key="NavRailBackgroundBrush" Color="#F3F2F1" />
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#E1DFDD" />
    <SolidColorBrush x:Key="NavItemSelectedBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1DFDD" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#605E5C" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E1DFDD" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#D0CFCD" />

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C8C6C4" />

</ResourceDictionary>
