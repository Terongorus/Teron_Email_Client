<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TeronEmailClient</RootNamespace>
    <AssemblyName>TeronEmailClient</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>email.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>

    <Product>Teron's Email Client (TEC)</Product>
    <Company>Teronverse</Company>
    <Copyright>Copyright © 2025-2026</Copyright>
    <Description>An open source, lightweight email client shell that hosts Gmail, Outlook and other webmail services side by side, switchable instantly like Outlook 365.</Description>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="email.ico" />
    <Resource Include="gmail.png" />
    <Resource Include="outlook.png" />
  </ItemGroup>

</Project>
